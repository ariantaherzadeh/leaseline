{
  "name": "@leaseline/site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "data": "cd ../.. && uv run leaseline export-site --tenant ${LEASELINE_TENANT:-demo} --out apps/site/src/data/site.json",
    "predev": "npm run data",
    "dev": "next dev",
    "prebuild": "npm run data",
    "build": "next build",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "next": "16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "@leaseline/shared": "*"
  },
  "devDependencies": {
    "@netlify/plugin-nextjs": "^5.16.2",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=22"
  }
}
